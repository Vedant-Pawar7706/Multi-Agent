# VoyageAI Backend Environment Configuration
PROJECT_NAME="VoyageAI Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default for zero-setup, PostgreSQL compatible)
DATABASE_URL="sqlite:///./voyageai.db"

# JWT Authentication Security
JWT_SECRET="voyageai-super-secret-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration ("gemini", "openai", "demo")
LLM_PROVIDER="gemini"
MODEL_NAME="gemini-2.5-flash"
GOOGLE_API_KEY=""
OPENAI_API_KEY=""

# External Search Tools (Optional)
SEARCH_API_KEY=""

# Server Settings
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
